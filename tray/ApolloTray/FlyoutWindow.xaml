<Window x:Class="ApolloTray.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Apollo" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Windows 11 Quick Settings toggle: rounded tile, accent fill when on, label underneath -->
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <StackPanel x:Name="Root">
        <!-- hero: who's streaming -->
        <Grid Margin="16,18,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="52" Height="52" Margin="0,0,14,0">
                <Ellipse x:Name="HeroDisc"/>
                <TextBlock x:Name="HeroGlyph" FontFamily="{StaticResource Icons}" FontSize="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="HeroName" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="HeroDetail" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button x:Name="EndButton" Grid.Column="2" Style="{StaticResource SmallButton}" Content="Disconnect"
                    VerticalAlignment="Center" Margin="8,0,0,0" Click="End_Click"/>
        </Grid>

        <!-- quick toggles -->
        <Grid Margin="16,18,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ToggleButton x:Name="MonitorTile" Style="{StaticResource Tile}" Content="&#xE7F4;"
                              AutomationProperties.Name="Desk monitor" Click="Monitor_Click"/>
                <TextBlock x:Name="MonitorLabel" Style="{StaticResource TileLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <ToggleButton x:Name="AudioTile" Style="{StaticResource Tile}"
                              AutomationProperties.Name="Desk audio" Click="Audio_Click"/>
                <TextBlock x:Name="AudioLabel" Style="{StaticResource TileLabel}"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ScopeText" FontSize="11" Margin="16,10,16,16" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

        <!-- pairing + footer -->
        <Border x:Name="LowerPane" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="16,12,8,8">
            <StackPanel>
                <TextBlock Text="Pair a device" FontSize="12" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PinBox" MaxLength="4" FontSize="14" TextAlignment="Center"
                             AutomationProperties.Name="PIN" PreviewTextInput="Pin_PreviewTextInput"
                             TextChanged="Pair_TextChanged" KeyDown="Pair_KeyDown"/>
                    <!-- WPF has no placeholder text: a hint that hides once there's input -->
                    <TextBlock x:Name="PinHint" Text="PIN" FontSize="14" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBox x:Name="NameBox" Grid.Column="2" FontSize="14"
                             AutomationProperties.Name="Device name" TextChanged="Pair_TextChanged" KeyDown="Pair_KeyDown"/>
                    <TextBlock x:Name="NameHint" Grid.Column="2" Text="Device name" FontSize="14" IsHitTestVisible="False"
                               Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <Button x:Name="PairButton" Grid.Column="4" Content="Pair" IsEnabled="False" Click="Pair_Click"/>
                </Grid>
                <TextBlock x:Name="PairHint" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Start pairing on the device, then enter the PIN it shows."/>
                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="FooterText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open Apollo settings"
                                AutomationProperties.Name="Open Apollo settings" Click="WebUi_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
